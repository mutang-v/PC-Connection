<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:gravity="center_horizontal"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="电脑伴侣"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="安卓控制台 · 硬件监控 &amp; 手机控制"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="26dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电脑 IP / 主机名"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_bg"
            android:hint="例如 192.168.43.25 或 主机名"
            android:inputType="text"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 位配对码"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="14dp" />

        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_bg"
            android:hint="输入电脑窗口显示的 8 位数字"
            android:inputType="number"
            android:maxLines="1"
            android:maxLength="8"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="18sp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_outline_green"
            android:text="扫一扫配对（扫码自动填充）"
            android:textColor="#47E1A1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnPair"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_green"
            android:text="验证并配对此设备"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvPairErr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/accent_red"
            android:textSize="13sp"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="首次连接需要在电脑服务窗口中查看 8 位配对码。配对码 10 分钟内有效，只能使用一次。请只在自己可信的热点/局域网内使用。"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:paddingTop="16dp" />
    </LinearLayout>

</LinearLayout>
